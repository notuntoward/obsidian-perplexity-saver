{
  "name": "perplexity-saver",
  "version": "1.0.0",
  "description": "Saves Perplexity dialogs into Obsidian",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "bundle": "node esbuild.config.mjs production",
    "verify": "node scripts/verify-bundle.mjs",
    "lint": "eslint . --cache --max-warnings=0",
    "lint:community-review": "eslint . --config eslint.community-review.config.mjs --max-warnings=0",
    "typecheck": "tsc --noEmit -skipLibCheck",
    "check": "npm run lint && npm run lint:community-review && npm run typecheck",
    "build": "npm run check && npm test && npm run bundle",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "test:browser": "playwright test",
    "bundle:repair": "node scripts/build-lit-note-repair.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "perplexity"
  ],
  "author": "Scott Otterson",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@types/stopword": "^2.0.3",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "commons": "file:../obsidian-commons",
    "esbuild": "^0.28.0",
    "eslint": "^10.9.0",
    "eslint-plugin-obsidianmd": "^0.6.0",
    "fast-check": "^4.9.0",
    "globals": "^17.11.0",
    "jsdom": "^30.1.2",
    "obsidian": "~1.14.4",
    "playwright": "^1.59.1",
    "prettier": "^3.9.10",
    "tslib": "^2.6.2",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@lezer/markdown": "^1.6.0",
    "stopword": "^3.1.5"
  }
}
