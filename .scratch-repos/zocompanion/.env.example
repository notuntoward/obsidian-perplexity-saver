# Usage:
# Copy this file as `.env` and fill in the variables below.

# Windows: escape backslashes as \\
# Example binary: C:\\Program Files\\Zotero\\zotero.exe
# Example profile: start Zotero with `zotero.exe -p`, create a profile named zotero-dev,
# then paste that profile folder path here.

ZOTERO_PLUGIN_ZOTERO_BIN_PATH = /path/to/zotero.exe

ZOTERO_PLUGIN_PROFILE_PATH = /path/to/profile

ZOTERO_PLUGIN_DATA_DIR =
